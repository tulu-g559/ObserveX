{
  "manifest_version": 3,
  "name": "ObserveX",
  "version": "0.1.0",
  "description": "AI-powered browser activity intelligence. Captures, understands, and organizes your day.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.observex.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
