# ---- ObserveX backend configuration ----
# Copy this file to `.env` and adjust values before starting the stack.

# Application name used in logs.
APP_NAME=ObserveX

# Runtime environment label: development | production
ENV=development

# SQLAlchemy connection string (psycopg3 driver).
# Inside docker-compose, the host is the service name `postgres`.
DATABASE_URL=postgresql+psycopg://observex:observex@postgres:5432/observex

# Celery broker + result backend URL.
# Inside docker-compose, the host is the service name `redis`.
REDIS_URL=redis://redis:6379/0

# Google AI Studio API key for Gemini Vision analysis.
# Leave empty to always use the PaddleOCR fallback (low-confidence results).
GEMINI_API_KEY=your_gemini_key_here

# Gemini model identifier used for screenshot analysis.
GEMINI_MODEL=gemini-3.6-flash

# Maximum accepted screenshot size in megabytes (413 when exceeded).
MAX_UPLOAD_MB=5

# Reserved for future authentication (no auth is enforced yet).
JWT_SECRET=change-me
